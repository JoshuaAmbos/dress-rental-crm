@host = http://localhost:5171

### Register Company
POST {{host}}/companies
Content-Type: application/json

{
  "companyCode": "COMP001",
  "companyName": "Dream Dress Rentals Boutique",
  "isActive": true
}

### Register Workstation Device
POST {{host}}/devices
Content-Type: application/json

{
  "companyId": 1,
  "deviceCode": "DEV001",
  "deviceName": "Main PC",
  "isActive": true
}

### Register Database Routing for Company 1
POST {{host}}/company-databases
Content-Type: application/json

{
  "companyId": 1,
  "serverName": "localhost,1433",
  "databaseName": "DB_TenantCRM",
  "credentialKey": "TenantA",
  "isActive": true
}